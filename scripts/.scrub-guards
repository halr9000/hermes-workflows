# Publish-scrub allow-list: one entry per line.
#   file            -> every hit in that file is a GUARD
#   file:LINE       -> the hit at that source line is a GUARD
#   regex:PATTERN   -> any hit whose line matches PATTERN is a false-positive guard
# Kept verbatim per docs/PUBLISH-SCRUB.md.
tests/test_skill_docs.py
scripts/make_public.py
regex:exhaust
docs/catalog/entry.yaml
docs/catalog/pr-body.md
docs/manifest-decisions.md
plugin.yaml
regex:NousResearch/hermes-agent
scripts/.scrub-guards
regex:"author": "(Jacob Hausler|jacobhausler)"
# Public PR-author credit only; anchored line excludes the change description.
regex:^- #[0-9]+ — (Hermes Agent; )?@jacobhausler\.$
# MIT license identity: the copyright-holder line is load-bearing by design
# (renaming it would mislicense the package); the audit reaching it is a
# feature of content-based text detection, not a regression. Anchored so the
# guard covers ONLY the copyright line of LICENSE.
regex:^Copyright \(c\) \d{4} (Jacob Hausler|jacobhausler)$

# ---- #499 quota route-identity fixture (2026-10-21) ----
# The spelling-fold pair must carry the `claude-` prefix: stock core folds '.'->'-'
# ONLY for claude-prefixed Anthropic ids, so a neutral prefix would test nothing. The
# model names are invented; anchored to the three fixture-assignment lines (not the
# file), so a stray vendor model name anywhere else still fires. GUARD, same
# fixture-identity class as tests/test_route_identity_699.py:54-57.
regex:^(DOT|DOT_M|FOLD) = "(anthropic/)?claude-model-5

